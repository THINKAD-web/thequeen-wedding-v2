# Anthropic API (Vercel: Project Settings → Environment Variables)
ANTHROPIC_API_KEY=sk-ant-...

# Neon PostgreSQL (chatbot logs) — console.neon.tech Connection String
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Chatbot admin (/admin)
ADMIN_PASSWORD=your-secure-password
ADMIN_SESSION_SECRET=tq-secret-key-change-me

# Optional: Kakao JavaScript key for content page share button
# KAKAO_JS_KEY=

# Optional: Upstash Redis (visit tracking / forms)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
